{
  "$defs": {
    "CodeLocation": {
      "properties": {
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "type": "object"
    },
    "CommitRange": {
      "properties": {
        "base": {
          "$ref": "#/$defs/Sha"
        },
        "head": {
          "$ref": "#/$defs/Sha"
        }
      },
      "required": [
        "base",
        "head"
      ],
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "locator": {
          "$ref": "#/$defs/Line"
        },
        "result": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "kind",
        "locator",
        "result"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "Command",
        "Test",
        "Mutation",
        "Probe",
        "SourceRead",
        "Capture"
      ],
      "type": "string"
    },
    "FindingConfidence": {
      "enum": [
        "Confirmed",
        "Plausible"
      ],
      "type": "string"
    },
    "FindingOrigin": {
      "enum": [
        "Introduced",
        "PreExisting"
      ],
      "type": "string"
    },
    "FindingSeverity": {
      "enum": [
        "Blocker",
        "High",
        "Medium",
        "Low"
      ],
      "type": "string"
    },
    "ForeignRef": {
      "description": "A citation of a document in another repo's pipeline store (D6).",
      "properties": {
        "commit": {
          "$ref": "#/$defs/FullSha"
        },
        "id": {
          "$ref": "#/$defs/Short"
        },
        "kind": {
          "$ref": "#/$defs/PipelineKind"
        },
        "payload_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "repo": {
          "$ref": "#/$defs/OrgRepo"
        }
      },
      "required": [
        "repo",
        "commit",
        "kind",
        "id",
        "payload_sha256"
      ],
      "type": "object"
    },
    "FullSha": {
      "description": "A full git commit id: exactly 40 lowercase hex characters.",
      "maxLength": 40,
      "type": "string"
    },
    "Label": {
      "description": "A key label: `[A-Za-z0-9_-]{1,64}`.",
      "maxLength": 64,
      "type": "string"
    },
    "Line": {
      "description": "Text of at most 1,000 UTF-8 bytes.",
      "maxLength": 1000,
      "type": "string"
    },
    "OrgRepo": {
      "description": "A GitHub repository as `Org/Repo`, at most 140 UTF-8 bytes (39 + 1 +\n100). The owner is 1 to 39 `[A-Za-z0-9-]` bytes with no leading or\ntrailing hyphen; the repo is 1 to 100 `[A-Za-z0-9._-]` bytes, is never\n`.` or `..`, and does not end in `.git`, ASCII-case-insensitively.\nIdentity is case-insensitive: `GameCult/Epiphany` and `gamecult/epiphany`\nare the same repository.",
      "maxLength": 140,
      "type": "string"
    },
    "Para": {
      "description": "Text of at most 4,000 UTF-8 bytes; longer narrative is cited by `DocRef`.",
      "maxLength": 4000,
      "type": "string"
    },
    "PipelineKind": {
      "enum": [
        "Campaign",
        "Target",
        "Question",
        "Ruling",
        "CutSpec",
        "CutReport",
        "Verdict",
        "Finding",
        "FollowUp",
        "Resolution",
        "Instance",
        "Stewardship",
        "HandOff"
      ],
      "type": "string"
    },
    "Sha": {
      "description": "A git commit id: 7-40 lowercase hex characters.",
      "maxLength": 40,
      "type": "string"
    },
    "Sha256Hex": {
      "description": "A SHA-256 digest: exactly 64 lowercase hex characters.",
      "maxLength": 64,
      "type": "string"
    },
    "Short": {
      "description": "Text of at most 200 UTF-8 bytes.",
      "maxLength": 200,
      "type": "string"
    },
    "Slug": {
      "description": "A campaign slug or key segment: label parts joined by `.`.",
      "maxLength": 64,
      "type": "string"
    }
  },
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.pipeline.finding.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "campaign": {
      "$ref": "#/$defs/Slug"
    },
    "claim": {
      "$ref": "#/$defs/Line"
    },
    "confidence": {
      "$ref": "#/$defs/FindingConfidence"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 16,
      "type": "array"
    },
    "failure_scenario": {
      "$ref": "#/$defs/Para"
    },
    "invariants": {
      "items": {
        "$ref": "#/$defs/Label"
      },
      "maxItems": 8,
      "type": "array"
    },
    "label": {
      "$ref": "#/$defs/Label"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "maxItems": 16,
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/FindingOrigin"
    },
    "precedents": {
      "items": {
        "$ref": "#/$defs/ForeignRef"
      },
      "maxItems": 8,
      "type": "array"
    },
    "range": {
      "$ref": "#/$defs/CommitRange"
    },
    "severity": {
      "$ref": "#/$defs/FindingSeverity"
    },
    "verdict": {
      "$ref": "#/$defs/Short"
    }
  },
  "required": [
    "campaign",
    "verdict",
    "label",
    "range",
    "confidence",
    "severity",
    "claim",
    "invariants",
    "locations",
    "failure_scenario",
    "evidence",
    "precedents",
    "origin"
  ],
  "title": "PipelineFinding",
  "type": "object"
}
