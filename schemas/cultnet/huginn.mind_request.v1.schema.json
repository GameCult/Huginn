{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HuginnMindRequest",
  "description": "Every operation a mind answers. `Admit` carries the batch whole because the\nbatch already names the instance and the asker; a second `instance` beside\nit would be two declarations. Every read names the instance because ruling\n14 refuses another mind's identity whatever the transport, and a read of\nthe wrong mind is that same collision on the read side. `Whoami` names\nnone: it is how a client learns which mind it reached.",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "Whoami"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Admit": {
          "$ref": "#/$defs/PipelineAdmissionBatch"
        }
      },
      "additionalProperties": false,
      "required": [
        "Admit"
      ]
    },
    {
      "type": "object",
      "properties": {
        "View": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PipelineRef"
            },
            "instance": {
              "$ref": "#/$defs/Slug"
            }
          },
          "required": [
            "instance",
            "id"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "View"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Query": {
          "type": "object",
          "properties": {
            "instance": {
              "$ref": "#/$defs/Slug"
            },
            "query": {
              "$ref": "#/$defs/PipelineQuery"
            }
          },
          "required": [
            "instance",
            "query"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Query"
      ]
    },
    {
      "type": "object",
      "properties": {
        "OpenItems": {
          "type": "object",
          "properties": {
            "campaign": {
              "$ref": "#/$defs/Slug"
            },
            "instance": {
              "$ref": "#/$defs/Slug"
            }
          },
          "required": [
            "instance",
            "campaign"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "OpenItems"
      ]
    },
    {
      "type": "object",
      "properties": {
        "History": {
          "type": "object",
          "properties": {
            "instance": {
              "$ref": "#/$defs/Slug"
            },
            "scope": {
              "$ref": "#/$defs/HistoryScope"
            }
          },
          "required": [
            "instance",
            "scope"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "History"
      ]
    }
  ],
  "$defs": {
    "AuthorityMap": {
      "type": "object",
      "properties": {
        "deletion_line": {
          "$ref": "#/$defs/Line"
        },
        "derived_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        },
        "forbidden_writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        },
        "owner": {
          "$ref": "#/$defs/Line"
        },
        "shared_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        }
      },
      "required": [
        "owner",
        "inputs",
        "outputs",
        "derived_state",
        "forbidden_writers",
        "shared_paths",
        "deletion_line"
      ]
    },
    "ClaimOutcome": {
      "type": "string",
      "enum": [
        "Holds",
        "Falsified",
        "Unproven"
      ]
    },
    "CodeLocation": {
      "type": "object",
      "properties": {
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "path",
        "line"
      ]
    },
    "CommitRange": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/Sha"
        },
        "head": {
          "$ref": "#/$defs/Sha"
        }
      },
      "required": [
        "base",
        "head"
      ]
    },
    "CutDelete": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "note": {
          "$ref": "#/$defs/Line"
        },
        "path": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "path",
        "lines",
        "note"
      ]
    },
    "CutVerification": {
      "type": "object",
      "properties": {
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 64
        },
        "negative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NegativeCheck"
          },
          "maxItems": 64
        },
        "operator": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 64
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationTest"
          },
          "maxItems": 64
        }
      },
      "required": [
        "builds",
        "tests",
        "negative",
        "operator"
      ]
    },
    "Date": {
      "description": "A calendar date, `YYYY-MM-DD`.",
      "type": "string",
      "maxLength": 10
    },
    "Deviation": {
      "type": "object",
      "properties": {
        "what": {
          "$ref": "#/$defs/Line"
        },
        "why": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "what",
        "why"
      ]
    },
    "DocRef": {
      "type": "object",
      "properties": {
        "commit": {
          "$ref": "#/$defs/Sha"
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/Short"
        },
        "start_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line",
        "commit"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "locator": {
          "$ref": "#/$defs/Line"
        },
        "result": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "kind",
        "locator",
        "result"
      ]
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "Command",
        "Test",
        "Mutation",
        "Probe",
        "SourceRead",
        "Capture"
      ]
    },
    "Faculty": {
      "description": "Which faculty a batch was admitted as. Attribution, not authority\n(ruling 18): no admission rule trusts it, and Cut 9's views read it back\nfrom the receipt.",
      "type": "string",
      "enum": [
        "SelfFaculty",
        "Imagination",
        "Hands",
        "Soul",
        "MindSteward",
        "Eyes",
        "Operator"
      ]
    },
    "FileChange": {
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/Line"
        },
        "location": {
          "$ref": "#/$defs/CodeLocation"
        }
      },
      "required": [
        "location",
        "change"
      ]
    },
    "FindingConfidence": {
      "type": "string",
      "enum": [
        "Confirmed",
        "Plausible"
      ]
    },
    "FindingOrigin": {
      "type": "string",
      "enum": [
        "Introduced",
        "PreExisting"
      ]
    },
    "FindingSeverity": {
      "type": "string",
      "enum": [
        "Blocker",
        "High",
        "Medium",
        "Low"
      ]
    },
    "ForeignRef": {
      "description": "A citation of a document in another repo's pipeline store (D6).",
      "type": "object",
      "properties": {
        "commit": {
          "$ref": "#/$defs/FullSha"
        },
        "id": {
          "$ref": "#/$defs/Short"
        },
        "kind": {
          "$ref": "#/$defs/PipelineKind"
        },
        "payload_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "repo": {
          "$ref": "#/$defs/OrgRepo"
        }
      },
      "required": [
        "repo",
        "commit",
        "kind",
        "id",
        "payload_sha256"
      ]
    },
    "FullSha": {
      "description": "A full git commit id: exactly 40 lowercase hex characters.",
      "type": "string",
      "maxLength": 40
    },
    "HistoryScope": {
      "description": "What a history is a history of: every resolution one subject ever had, or\nevery assignment of one repo to this mind.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Subject": {
              "$ref": "#/$defs/PipelineRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "Subject"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Repo": {
              "$ref": "#/$defs/OrgRepo"
            }
          },
          "additionalProperties": false,
          "required": [
            "Repo"
          ]
        }
      ]
    },
    "Label": {
      "description": "A key label: `[A-Za-z0-9_-]{1,64}`.",
      "type": "string",
      "maxLength": 64
    },
    "LandedName": {
      "description": "A name the cut landed, and where it lives.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Short"
        },
        "path": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "name",
        "path"
      ]
    },
    "Line": {
      "description": "Text of at most 1,000 UTF-8 bytes.",
      "type": "string",
      "maxLength": 1000
    },
    "MutationRecord": {
      "description": "One mutation a report ran: a key-safe label a verdict claim can name,\nthe exact edit, and the tree it was applied to.",
      "type": "object",
      "properties": {
        "after": {
          "$ref": "#/$defs/Line"
        },
        "before": {
          "$ref": "#/$defs/Line"
        },
        "commit": {
          "$ref": "#/$defs/Sha"
        },
        "failed_as_expected": {
          "type": "boolean"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "rule": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "label",
        "rule",
        "location",
        "before",
        "after",
        "commit",
        "failed_as_expected"
      ]
    },
    "NegativeCheck": {
      "type": "object",
      "properties": {
        "pattern": {
          "$ref": "#/$defs/Short"
        },
        "scope": {
          "$ref": "#/$defs/Line"
        }
      },
      "required": [
        "pattern",
        "scope"
      ]
    },
    "OrgRepo": {
      "description": "A GitHub repository as `Org/Repo`.",
      "type": "string",
      "maxLength": 200
    },
    "Para": {
      "description": "Text of at most 4,000 UTF-8 bytes; longer narrative is cited by `DocRef`.",
      "type": "string",
      "maxLength": 4000
    },
    "PipelineAdmissionBatch": {
      "description": "One admission request: the mind it is for, who asks, and the documents.\nRides the wire whole (`wire::HuginnMindRequest::Admit`).",
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PipelineDocument"
          }
        },
        "instance": {
          "$ref": "#/$defs/Slug"
        },
        "provenance": {
          "$ref": "#/$defs/PipelineProvenance"
        }
      },
      "required": [
        "instance",
        "provenance",
        "documents"
      ]
    },
    "PipelineCampaign": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrgRepo"
          },
          "maxItems": 8
        },
        "slug": {
          "$ref": "#/$defs/Slug"
        },
        "target_doc": {
          "$ref": "#/$defs/DocRef"
        },
        "title": {
          "$ref": "#/$defs/Short"
        },
        "working_branch": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "slug",
        "title",
        "repos",
        "working_branch",
        "target_doc"
      ]
    },
    "PipelineCutReport": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "branch": {
          "$ref": "#/$defs/Short"
        },
        "campaign": {
          "$ref": "#/$defs/Slug"
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportCommit"
          },
          "maxItems": 128
        },
        "cut_spec": {
          "$ref": "#/$defs/Short"
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Deviation"
          },
          "maxItems": 32
        },
        "forks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Short"
          },
          "maxItems": 8
        },
        "landed_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LandedName"
          },
          "maxItems": 128
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MutationRecord"
          },
          "maxItems": 64
        },
        "promises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Promise"
          },
          "maxItems": 64
        },
        "range": {
          "$ref": "#/$defs/CommitRange"
        },
        "repo": {
          "$ref": "#/$defs/OrgRepo"
        },
        "structural_delta": {
          "$ref": "#/$defs/StructuralDelta"
        },
        "undone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 32
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64
        }
      },
      "required": [
        "campaign",
        "cut_spec",
        "attempt",
        "repo",
        "branch",
        "commits",
        "range",
        "verification",
        "mutations",
        "deviations",
        "forks",
        "structural_delta",
        "landed_names",
        "undone",
        "promises"
      ]
    },
    "PipelineCutSpec": {
      "type": "object",
      "properties": {
        "adds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 64
        },
        "authority_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorityMap"
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "$ref": "#/$defs/Sha"
        },
        "branch": {
          "$ref": "#/$defs/Short"
        },
        "campaign": {
          "$ref": "#/$defs/Slug"
        },
        "cut": {
          "$ref": "#/$defs/Label"
        },
        "deletes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CutDelete"
          },
          "maxItems": 64
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Short"
          },
          "maxItems": 8
        },
        "estimate": {
          "$ref": "#/$defs/StructuralDelta"
        },
        "file_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "maxItems": 256
        },
        "first": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 16
        },
        "keeps_moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          },
          "maxItems": 64
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Short"
          },
          "maxItems": 16
        },
        "repo": {
          "$ref": "#/$defs/OrgRepo"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rulings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Short"
          },
          "maxItems": 32
        },
        "title": {
          "$ref": "#/$defs/Short"
        },
        "verification": {
          "$ref": "#/$defs/CutVerification"
        }
      },
      "required": [
        "campaign",
        "cut",
        "revision",
        "title",
        "repo",
        "branch",
        "base",
        "depends_on",
        "first",
        "deletes",
        "keeps_moves",
        "adds",
        "file_changes",
        "verification",
        "estimate",
        "rulings",
        "questions"
      ]
    },
    "PipelineDocument": {
      "description": "The envelope enum, adjacently tagged on the kind name: a document\non a wire is `{ kind, value }`, and `kind` is exactly what\n`PipelineKind::name()` returns, so a reader dispatches on the kind\nsegment it already knows from the key and needs no second registry\nmapping variant spellings to kinds. Adjacent rather than internal\nbecause a value is a named map of its own and an internal tag would\nhave to be merged into it; the tag stays beside the value instead.\nThis is not a published schema: `schemas/cultnet` publishes the\nthirteen per-kind value documents, and the envelope is the wire's\nshape, not a document's.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "campaign"
            },
            "value": {
              "$ref": "#/$defs/PipelineCampaign"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target"
            },
            "value": {
              "$ref": "#/$defs/PipelineTarget"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "question"
            },
            "value": {
              "$ref": "#/$defs/PipelineQuestion"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ruling"
            },
            "value": {
              "$ref": "#/$defs/PipelineRuling"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cut_spec"
            },
            "value": {
              "$ref": "#/$defs/PipelineCutSpec"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cut_report"
            },
            "value": {
              "$ref": "#/$defs/PipelineCutReport"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "verdict"
            },
            "value": {
              "$ref": "#/$defs/PipelineVerdict"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finding"
            },
            "value": {
              "$ref": "#/$defs/PipelineFinding"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "follow_up"
            },
            "value": {
              "$ref": "#/$defs/PipelineFollowUp"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resolution"
            },
            "value": {
              "$ref": "#/$defs/PipelineResolution"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instance"
            },
            "value": {
              "$ref": "#/$defs/PipelineInstance"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stewardship"
            },
            "value": {
              "$ref": "#/$defs/PipelineStewardship"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hand_off"
            },
            "value": {
              "$ref": "#/$defs/PipelineHandOff"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "PipelineFinding": {
      "type": "object",
      "properties": {
        "campaign": {
          "$ref": "#/$defs/Slug"
        },
        "claim": {
          "$ref": "#/$defs/Line"
        },
        "confidence": {
          "$ref": "#/$defs/FindingConfidence"
        },
        "evidence": {
