                  "type": "string"
                }
              },
              "required": [
                "found",
                "expected"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ForeignEpoch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ForeignStore": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ForeignStore"
          ]
        },
        {
