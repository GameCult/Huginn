        "context",
        "options",
        "recommendation",
        "depends",
        "leans",
        "flag",
        "raised_in",
        "deciders",
        "status",
        "ruling",
        "ruled_from",
        "order",
        "options_hash"
      ]
    },
    "ForkDeskAnswer": {
      "description": "`gamecult.desk_answer.v0`: one stored answer as the desk shows it, her field order,\n`request_id` last. Every value is a stored fact; `answer_id`, `of` and `retracts` are the\nrecord keys in her `n<seq>` spelling.",
