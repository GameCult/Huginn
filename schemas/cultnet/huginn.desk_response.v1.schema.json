{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeskResponse",
  "description": "What the door answers one desk request with. `Answered` is a stored answer, refused ones\nincluded (a stale fork, a non-decider and the rest are stored), fresh or replayed alike.\n`Forks` and `Fork` are the reads: one page of entries, or one entry, with the head they were\nall read at. `NotStored` is a request that stored nothing (an unknown fork included).\n`Refused` is any other Mind refusal; an `Unavailable` is Bifrost's to turn into its 503, and\nHuginn writes no document for it.\n\nThe trust boundary of the reads (ruling `desk-read-visibility-whole-record`): `Forks` and `Fork`\ncarry the WHOLE record, every answer's note included, to whatever the peer-checked socket\ncarries. Huginn strips nothing and gates nothing; Bifrost applies visibility at its door (a\nstripped read serves `note: null`, CultLib `fork-card.md`). Huginn must therefore be reachable\nonly by Bifrost's peer-checked socket: the peer-uid check IS the whole authentication, and a\nsecond reader of that socket is a note leak.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "Answered": {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "#/$defs/ForkDeskAnswer"
            },
            "as_of": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "counted_answer_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "answer",
            "as_of"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Answered"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Forks": {
          "type": "object",
          "properties": {
            "as_of": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "list": {
              "$ref": "#/$defs/ForkList"
            }
          },
          "required": [
            "list",
            "as_of"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Forks"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Fork": {
          "type": "object",
          "properties": {
            "as_of": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "entry": {
              "$ref": "#/$defs/ForkEntry"
            }
          },
          "required": [
            "entry",
            "as_of"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "Fork"
      ]
    },
    {
      "type": "object",
      "properties": {
        "NotStored": {
          "$ref": "#/$defs/ForkRefusal"
        }
      },
      "additionalProperties": false,
      "required": [
        "NotStored"
      ]
    },
    {
      "type": "object",
      "properties": {
        "Refused": {
          "$ref": "#/$defs/MindRefusal"
        }
      },
      "additionalProperties": false,
      "required": [
        "Refused"
      ]
    }
  ],
  "$defs": {
