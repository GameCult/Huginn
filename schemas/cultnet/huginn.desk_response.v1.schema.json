        },
        "choice": {
          "type": "string"
        },
        "claim_in_future": {
          "type": "boolean"
        },
        "code": {
          "description": "The six codes a refused answer is stored with, as her schema spells them.",
          "type": "string",
          "enum": [
            "stale_fork",
            "not_a_decider",
            "fork_closed",
            "choice_invalid",
            "bad_retraction",
            "already_retracted"
          ]
        },
        "fork_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "of": {
          "type": "string"
        },
        "options_hash": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "received_at": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retracts": {
          "type": "string"
        },
        "schemaVersion": {
          "$ref": "#/$defs/AnswerSchema"
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "answer_id",
        "fork_id",
        "outcome",
        "of",
        "retracts",
        "code",
        "options_hash",
        "choice",
        "note",
        "answered_at",
        "received_at",
        "claim_in_future",
        "answerer",
        "authority",
        "request_id"
      ]
    },
    "ForkEntry": {
