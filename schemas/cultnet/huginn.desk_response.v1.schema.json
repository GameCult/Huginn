    "MindRefusal": {
      "description": "Every way a mind refuses. `Document` wraps the leaf's four (bounds,\nformats, key identity, foreign type); the rest are the organ's: store\nidentity, epoch, ownership, batch shape, references, and every cross-field\nand cross-document rule of admission.\n\nThe two sequenced kinds refuse in the same pair of shapes: an\n`OutOfSequence` when the writer's `sequence` is not the previous plus one,\nand `AlreadyResolved`/`AlreadyStewarded` when a record of that scope is\nstill in force.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "MissingIdentity",
            "EmptySupersession",
            "FindingWithoutRange",
            "FindingWithoutEvidence"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Document": {
              "$ref": "#/$defs/PipelineRefusal"
            }
          },
          "additionalProperties": false,
          "required": [
            "Document"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ForeignInstance": {
              "type": "object",
              "properties": {
                "declared": {
                  "type": "string"
                },
                "mind": {
                  "type": "string"
                }
              },
              "required": [
                "declared",
                "mind"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ForeignInstance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ForeignEpoch": {
              "type": "object",
