{
  "$defs": {
    "CodeLocation": {
      "properties": {
        "end_line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/Short"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "type": "object"
    },
    "Label": {
      "description": "A key label: `[A-Za-z0-9_-]{1,64}`.",
      "maxLength": 64,
      "type": "string"
    },
    "Line": {
      "description": "Text of at most 1,000 UTF-8 bytes.",
      "maxLength": 1000,
      "type": "string"
    },
    "OrgRepo": {
      "description": "A GitHub repository as `Org/Repo`, at most 140 UTF-8 bytes (39 + 1 +\n100). The owner is 1 to 39 `[A-Za-z0-9-]` bytes with no leading or\ntrailing hyphen; the repo is 1 to 100 `[A-Za-z0-9._-]` bytes, is never\n`.` or `..`, and does not end in `.git`, ASCII-case-insensitively.\nIdentity is case-insensitive: `GameCult/Epiphany` and `gamecult/epiphany`\nare the same repository.",
      "maxLength": 140,
      "type": "string"
    },
    "PipelineKind": {
      "enum": [
        "Campaign",
        "Target",
        "Question",
        "Ruling",
        "CutSpec",
        "CutReport",
        "Verdict",
        "Finding",
        "FollowUp",
        "Resolution",
        "Instance",
        "Stewardship",
        "HandOff"
      ],
      "type": "string"
    },
    "PipelineRef": {
      "description": "A reference to another document. The id is parsed as a full pipeline id of\nthe declared `kind`, so the kind and the id's kind segment cannot disagree.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Short"
        },
        "kind": {
          "$ref": "#/$defs/PipelineKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "Short": {
      "description": "Text of at most 200 UTF-8 bytes.",
      "maxLength": 200,
      "type": "string"
    },
    "Slug": {
      "description": "A campaign slug or key segment: label parts joined by `.`.",
      "maxLength": 64,
      "type": "string"
    }
  },
  "$id": "https://gamecult.dev/epiphany/cultnet/epiphany.pipeline.follow_up.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "campaign": {
      "$ref": "#/$defs/Slug"
    },
    "item": {
      "$ref": "#/$defs/Line"
    },
    "label": {
      "$ref": "#/$defs/Label"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "maxItems": 16,
      "type": "array"
    },
    "owner": {
      "$ref": "#/$defs/Short"
    },
    "repo": {
      "$ref": "#/$defs/OrgRepo"
    },
    "source": {
      "$ref": "#/$defs/PipelineRef"
    },
    "why_it_can_wait": {
      "$ref": "#/$defs/Line"
    }
  },
  "required": [
    "campaign",
    "label",
    "source",
    "repo",
    "locations",
    "item",
    "why_it_can_wait",
    "owner"
  ],
  "title": "PipelineFollowUp",
  "type": "object"
}
